{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://jobbpulse-app.onrender.com",
          "https://app.jobbpulse.com"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
