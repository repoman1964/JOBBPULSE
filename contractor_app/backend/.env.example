# Application
APP_ENV=development
DEBUG=false
JWT_SECRET=dev-only-change-me-in-production-use-32b+
AUTH_DEV_CODES=true
# Demo/hosted: set AUTH_SHOW_OTP=true so the app displays the code. No email is sent.
AUTH_SHOW_OTP=false
AUTH_FIXED_DEV_CODE=123456
AUTH_VERIFICATION_TTL_HOURS=24
# Local: leave RESEND_API_KEY empty — register returns verificationUrl.
# Production: Resend API key + a from-address on a verified domain.
# RESEND_API_KEY=
AUTH_FROM_EMAIL=JobbPulse <onboarding@resend.dev>
PUBLIC_API_BASE_URL=http://localhost:8000
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Database
# Host ports when using docker compose: Postgres 5433, Redis 6380
DATABASE_URL=postgresql+asyncpg://jobbpulse:jobbpulse@localhost:5433/jobbpulse

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Object storage — local MinIO. Production on Render uses Cloudflare R2
# (bucket jobbpulse, region auto). See contractor_app/RENDER.md.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jobbpulse
S3_REGION=us-east-1

# CORS / frontend
# Include every Nuxt origin you open in a browser (desktop + phone QR LAN URL)
# Phone QR uses your machine's LAN IP (e.g. http://10.0.0.156:3000), not localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://10.0.0.156:3000,http://10.0.0.156:3001,http://10.0.0.156:3002,http://10.0.0.156:3003,http://10.0.0.180:3000,http://10.0.0.180:3001,http://10.0.0.180:3002,http://10.0.0.180:3003
FRONTEND_BASE_URL=http://localhost:3000

# Providers: fake | live
PROVIDER_MODE=fake
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_BASE_URL=https://api.upload-post.com/api
# UPLOAD_POST_WEBHOOK_TOKEN=
# CONVERSION_SITE_API_URL=
# PORTFOLIO_SITE_API_URL=
