APP_ENV=development
APP_SECRET_KEY=dev-secret-change-me
DATABASE_URL=postgresql+asyncpg://jobpulse:jobpulse@localhost:5433/jobpulse
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jobpulse
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/jobpulse
JWT_SECRET=dev-jwt-secret-change-me
FRONTEND_URL=http://localhost:3000
DIRECTORY_URL=http://localhost:3001
# For phone QR demos, also add your LAN origin(s), e.g.:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://10.0.0.156:3000,http://10.0.0.156:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# And set S3_ENDPOINT / S3_PUBLIC_BASE_URL / FRONTEND_URL / DIRECTORY_URL to that LAN IP
# so the phone can hit the API, MinIO, and public links.
AI_PROVIDER=mock
PUBLISHING_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock

# Phase 8 pilot hardening
SENTRY_DSN=
BILLING_ENFORCE=false
FOUNDER_ADMIN_EMAILS=
STRIPE_WEBHOOK_SECRET=
