# Contractor app (Sign In)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Demo / contact mailto
NUXT_PUBLIC_CONTACT_EMAIL=hello@jobbpulse.com

# Question form delivery. Prefer Resend. If unset, the form offers a mailto draft.
INQUIRY_WEBHOOK_URL=
RESEND_API_KEY=
# Use onboarding@resend.dev until jobbpulse.com is verified, then hello@jobbpulse.com
INQUIRY_FROM_EMAIL=onboarding@resend.dev
# Inbox that receives questions. Until the domain is verified, this must be the Resend account email.
INQUIRY_TO_EMAIL=

# VSL under the hero (YouTube, Vimeo, or .mp4 URL)
NUXT_PUBLIC_VSL_URL=
NUXT_PUBLIC_VSL_POSTER=/images/jobs-page-clay.png
